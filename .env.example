# MySQL connection string
DATABASE_URL="mysql://user:password@localhost:3306/georgemckye"

# Public site URL (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL="https://georgemckye.shop"

# Owner's WhatsApp number for click-to-chat requests (digits only, with country code)
WHATSAPP_OWNER_NUMBER="919876543210"

# Admin login — used by prisma/seed.js to create/update the initial admin user.
# Change these before deploying, then run `npm run db:seed`.
ADMIN_EMAIL="admin@georgemckye.shop"
ADMIN_PASSWORD="change-this-password"

# Signs the admin session cookie. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional: Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=""
